<?xml version="1.0" encoding="utf-8"?>
<!-- region Settings -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_settings"
    app:startDestination="@id/mainSettings">

    <fragment
        android:id="@+id/mainSettings"
        android:name="com.watube.yard.ui.preferences.MainSettings"
        android:label="@string/settings" />

    <fragment
        android:id="@+id/appearanceSettings"
        android:name="com.watube.yard.ui.preferences.AppearanceSettings"
        android:label="@string/appearance" />
    <fragment
        android:id="@+id/backupRestoreSettings"
        android:name="com.watube.yard.ui.preferences.BackupRestoreSettings"
        android:label="@string/backup_restore" />
    <fragment
        android:id="@+id/playerSettings"
        android:name="com.watube.yard.ui.preferences.PlayerSettings"
        android:label="@string/player" />
    <fragment
        android:id="@+id/privacySettings"
        android:name="com.watube.yard.ui.preferences.PrivacySettings"
        android:label="@string/privacy" />

    <fragment
        android:id="@+id/maintenanceSettings"
        android:name="com.watube.yard.ui.preferences.MaintenanceSettings"
        android:label="@string/maintenance" />

    <!-- The former standalone screens are now merged into the five hub categories, so
         their actions land on the category that carries the very same preferences. -->
    <action
        android:id="@+id/action_global_privacySettings"
        app:destination="@id/privacySettings"
        app:enterAnim="@animator/watube_axis_enter"
        app:exitAnim="@animator/watube_axis_exit"
        app:popEnterAnim="@animator/watube_axis_pop_enter"
        app:popExitAnim="@animator/watube_axis_pop_exit" />

    <action
        android:id="@+id/action_global_generalSettings"
        app:destination="@id/maintenanceSettings"
        app:enterAnim="@animator/watube_axis_enter"
        app:exitAnim="@animator/watube_axis_exit"
        app:popEnterAnim="@animator/watube_axis_pop_enter"
        app:popExitAnim="@animator/watube_axis_pop_exit" />

    <action
        android:id="@+id/action_global_instanceSettings"
        app:destination="@id/privacySettings"
        app:enterAnim="@animator/watube_axis_enter"
        app:exitAnim="@animator/watube_axis_exit"
        app:popEnterAnim="@animator/watube_axis_pop_enter"
        app:popExitAnim="@animator/watube_axis_pop_exit" />

    <action
        android:id="@+id/action_global_maintenanceSettings"
        app:destination="@id/maintenanceSettings"
        app:enterAnim="@animator/watube_axis_enter"
        app:exitAnim="@animator/watube_axis_exit"
        app:popEnterAnim="@animator/watube_axis_pop_enter"
        app:popExitAnim="@animator/watube_axis_pop_exit" />

    <action
        android:id="@+id/action_global_appearanceSettings"
        app:destination="@id/appearanceSettings"
        app:enterAnim="@animator/watube_axis_enter"
        app:exitAnim="@animator/watube_axis_exit"
        app:popEnterAnim="@animator/watube_axis_pop_enter"
        app:popExitAnim="@animator/watube_axis_pop_exit" />

    <action
        android:id="@+id/action_global_audioVideoSettings"
        app:destination="@id/playerSettings"
        app:enterAnim="@animator/watube_axis_enter"
        app:exitAnim="@animator/watube_axis_exit"
        app:popEnterAnim="@animator/watube_axis_pop_enter"
        app:popExitAnim="@animator/watube_axis_pop_exit" />

    <action
        android:id="@+id/action_global_backupRestoreSettings"
        app:destination="@id/backupRestoreSettings"
        app:enterAnim="@animator/watube_axis_enter"
        app:exitAnim="@animator/watube_axis_exit"
        app:popEnterAnim="@animator/watube_axis_pop_enter"
        app:popExitAnim="@animator/watube_axis_pop_exit" />

    <action
        android:id="@+id/action_global_historySettings"
        app:destination="@id/privacySettings"
        app:enterAnim="@animator/watube_axis_enter"
        app:exitAnim="@animator/watube_axis_exit"
        app:popEnterAnim="@animator/watube_axis_pop_enter"
        app:popExitAnim="@animator/watube_axis_pop_exit" />

    <action
        android:id="@+id/action_global_notificationSettings"
        app:destination="@id/maintenanceSettings"
        app:enterAnim="@animator/watube_axis_enter"
        app:exitAnim="@animator/watube_axis_exit"
        app:popEnterAnim="@animator/watube_axis_pop_enter"
        app:popExitAnim="@animator/watube_axis_pop_exit" />

    <action
        android:id="@+id/action_global_playerSettings"
        app:destination="@id/playerSettings"
        app:enterAnim="@animator/watube_axis_enter"
        app:exitAnim="@animator/watube_axis_exit"
        app:popEnterAnim="@animator/watube_axis_pop_enter"
        app:popExitAnim="@animator/watube_axis_pop_exit" />

    <action
        android:id="@+id/action_global_sponsorBlockSettings"
        app:destination="@id/playerSettings"
        app:enterAnim="@animator/watube_axis_enter"
        app:exitAnim="@animator/watube_axis_exit"
        app:popEnterAnim="@animator/watube_axis_pop_enter"
        app:popExitAnim="@animator/watube_axis_pop_exit" />


</navigation>
<!-- endregion -->
