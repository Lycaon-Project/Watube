<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="BaseTheme" parent="Theme.Material3Expressive.Dark.NoActionBar">

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">false</item>

        <item name="switchPreferenceCompatStyle">
            @style/Preference.SwitchPreferenceCompat.Material3
        </item>

        <item name="snackbarStyle">@style/snackBarStyle</item>

        <item name="loadingIndicatorStyle">@style/Widget.Material3.LoadingIndicator.Contained</item>

        <item name="materialAlertDialogTheme">@style/AlertDialogTheme</item>

        <!-- Watube signature shapes -->
        <item name="shapeAppearanceSmallComponent">@style/WatubeShape.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/WatubeShape.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/WatubeShape.Large</item>

        <!-- Solar navigation: accent-soft pill behind the selected item -->
        <item name="itemActiveIndicatorStyle">@style/WatubeNavActiveIndicator</item>

        <!-- Solar chips: flat surface chip everywhere, including chips created
             from the plain Material Chip style. -->
        <item name="chipStyle">@style/Chip</item>
    </style>

    <style name="Theme.Watube" parent="BaseTheme">

        <item name="colorPrimary">@color/watube_theme_dark_primary</item>
        <item name="colorOnPrimary">@color/watube_theme_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/watube_theme_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/watube_theme_dark_onPrimaryContainer</item>
        <item name="colorSecondary">@color/watube_theme_dark_secondary</item>
        <item name="colorOnSecondary">@color/watube_theme_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/watube_theme_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/watube_theme_dark_onSecondaryContainer</item>
        <item name="colorTertiary">@color/watube_theme_dark_tertiary</item>
        <item name="colorOnTertiary">@color/watube_theme_dark_onTertiary</item>
        <item name="colorTertiaryContainer">@color/watube_theme_dark_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/watube_theme_dark_onTertiaryContainer</item>
        <item name="colorError">@color/watube_theme_dark_error</item>
        <item name="colorErrorContainer">@color/watube_theme_dark_errorContainer</item>
        <item name="colorOnError">@color/watube_theme_dark_onError</item>
        <item name="colorOnErrorContainer">@color/watube_theme_dark_onErrorContainer</item>
        <item name="android:colorBackground">@color/watube_theme_dark_background</item>
        <item name="colorOnBackground">@color/watube_theme_dark_onBackground</item>
        <item name="colorSurface">@color/watube_theme_dark_surface</item>
        <item name="colorOnSurface">@color/watube_theme_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/watube_theme_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/watube_theme_dark_onSurfaceVariant</item>
        <item name="colorOutline">@color/watube_theme_dark_outline</item>
        <item name="colorOnSurfaceInverse">@color/watube_theme_dark_inverseOnSurface</item>
        <item name="colorSurfaceInverse">@color/watube_theme_dark_inverseSurface</item>
        <item name="colorPrimaryInverse">@color/watube_theme_dark_inversePrimary</item>

        <item name="colorSurfaceContainerLowest">@color/watube_theme_dark_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/watube_theme_dark_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/watube_theme_dark_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/watube_theme_dark_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/watube_theme_dark_surfaceContainerHighest</item>
        <item name="colorSurfaceDim">@color/watube_theme_dark_surfaceDim</item>
        <item name="colorSurfaceBright">@color/watube_theme_dark_surfaceBright</item>
        <item name="colorOutlineVariant">@color/watube_theme_dark_outlineVariant</item>


    </style>




    <style name="Pure">

        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#050505</item>
        <item name="colorSurfaceContainer">#000000</item>
        <item name="colorSurfaceContainerHigh">#0A0A0A</item>
        <item name="colorSurfaceContainerHighest">#101010</item>
        <item name="colorSurfaceDim">#000000</item>
        <item name="colorSurfaceBright">#000000</item>
        <item name="colorSurfaceVariant">#0A0A0A</item>
        <item name="popupMenuBackground">@drawable/pure_theme_popup_menu_background</item>

    </style>

</resources>