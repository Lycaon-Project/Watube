<?xml version="1.0" encoding="utf-8"?>
<!--
  Solar chips (.chip / .chip.on): chip token surface, accent fill once the chip
  is selected, exactly like the mockup's single highlighted filter.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:color="?attr/colorPrimary"
        android:state_checked="true" />
    <item
        android:color="?attr/colorPrimary"
        android:state_selected="true" />
    <item android:color="@color/watube_chip_fill" />
</selector>
