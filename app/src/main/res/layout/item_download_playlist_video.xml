<?xml version="1.0" encoding="utf-8"?>
<!-- region Downloads -->
<!-- One video of a playlist to download (DownloadPlaylistVideosAdapter): the whole row ticks
     the box, and the screen reader hears it as a checkbox -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/video_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingVertical="6dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/video_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/video_thumbnail"
        android:layout_width="88dp"
        android:layout_height="50dp"
        android:layout_marginStart="2dp"
        android:background="@color/watube_chip_fill"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/WatubeDownloadThumbnail" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/video_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Lofi hip hop radio - beats to relax/study to" />

        <TextView
            android:id="@+id/video_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="3:24 · Lofi Girl" />

    </LinearLayout>

</LinearLayout>
<!-- endregion -->
