<?xml version="1.0" encoding="utf-8"?>
<!-- region Privacy -->
<!-- The privacy dashboard: protections, key figures, where the exchanges go, live activity,
     the busiest servers and what is kept on the phone. Read-only: the settings stay in the
     settings screen. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/privacy_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:clipToPadding="false"
    android:paddingBottom="16dp"
    tools:context=".ui.fragments.PrivacyFragment">

    <LinearLayout
        android:id="@+id/dashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/watube_gutter">

        <TextView
            style="@style/WatubeScreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:text="@string/privacy_tab" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/privacy_dashboard_intro"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <!-- protections: the ring, then the two figures that matter most -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/watube_qtile"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:id="@+id/protections"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:importantForAccessibility="yes">

                <com.watube.yard.ui.views.RingGaugeView
                    android:id="@+id/protections_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/protections_ratio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:textColor="?attr/colorOnSurface"
                        android:textFontWeight="800"
                        android:textSize="24sp"
                        tools:text="4/5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/privacy_protections_short"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />

                </LinearLayout>

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/encrypted_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:textColor="?attr/colorPrimary"
                    android:textFontWeight="800"
                    android:textSize="30sp"
                    tools:text="100 %" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/privacy_encrypted_label"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/refused_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFeatureSettings="tnum"
                    android:textColor="?attr/colorOnSurface"
                    android:textFontWeight="600"
                    android:textSize="15sp"
                    tools:text="0 requête bloquée" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/stat_requests"
                layout="@layout/watube_stat_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="9dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/stat_servers"
                layout="@layout/watube_stat_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/stat_skipped"
                layout="@layout/watube_stat_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="9dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/stat_saved"
                layout="@layout/watube_stat_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

        </LinearLayout>

        <!-- what the extractor did (PrivacyEvents, counted by PrivacyStats) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/stat_trackers"
                layout="@layout/watube_stat_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="9dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/stat_network"
                layout="@layout/watube_stat_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

        </LinearLayout>

        <TextView
            style="@style/WatubeDashboardTitle"
            android:text="@string/privacy_chart_destinations" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/watube_qtile"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:id="@+id/destinations"
                android:layout_width="124dp"
                android:layout_height="124dp"
                android:importantForAccessibility="yes">

                <com.watube.yard.ui.views.DonutChartView
                    android:id="@+id/destinations_chart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/destinations_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:textColor="?attr/colorOnSurface"
                        android:textFontWeight="800"
                        android:textSize="22sp"
                        tools:text="312" />

                    <TextView
                        android:id="@+id/destinations_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp"
                        tools:text="requêtes" />

                </LinearLayout>

            </FrameLayout>

            <LinearLayout
                android:id="@+id/legend_group"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:orientation="vertical" />

        </LinearLayout>

        <TextView
            style="@style/WatubeDashboardTitle"
            android:text="@string/privacy_chart_activity" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/watube_qtile"
            android:orientation="vertical"
            android:padding="16dp">

            <com.watube.yard.ui.views.SparklineView
                android:id="@+id/activity_chart"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:importantForAccessibility="yes" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/privacy_activity_caption"
                    android:textColor="?attr/colorOutline"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/activity_peak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFeatureSettings="tnum"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    tools:text="Pic : 24" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            style="@style/WatubeDashboardTitle"
            android:text="@string/privacy_chart_hosts" />

        <LinearLayout
            android:id="@+id/network_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/watube_qtile"
            android:divider="@drawable/watube_privacy_divider"
            android:orientation="vertical"
            android:paddingVertical="6dp"
            android:showDividers="middle" />

        <TextView
            android:id="@+id/network_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/watube_qtile"
            android:padding="16dp"
            android:text="@string/privacy_network_empty"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            style="@style/WatubeDashboardTitle"
            android:text="@string/privacy_section_device" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                android:id="@+id/stat_history"
                layout="@layout/watube_stat_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="9dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/stat_searches"
                layout="@layout/watube_stat_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/stat_positions"
                layout="@layout/watube_stat_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="9dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/stat_cache"
                layout="@layout/watube_stat_tile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
<!-- endregion -->
