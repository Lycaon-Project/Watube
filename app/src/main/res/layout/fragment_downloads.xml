<?xml version="1.0" encoding="utf-8"?>
<!-- region Downloads -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:id="@+id/search_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/search_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_back"
            android:padding="6dp"
            android:src="@drawable/watube_chevron_left"
            android:tint="?attr/colorOnSurface" />

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/watube_search_field"
            android:hint="@string/downloads_search_hint"
            android:imeOptions="actionSearch|flagNoPersonalizedLearning"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingTop="11dp"
            android:paddingEnd="16dp"
            android:paddingBottom="11dp"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            tools:text="cours promo" />

        <ImageButton
            android:id="@+id/search_clear"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_clear"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:tint="?attr/colorOnSurface"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/downloads_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_header">

        <!-- Video / Audio / Playlists as a floating pill, the bottom bar's sibling: its glass
             pill (the night one picked by DownloadsFragment), the selected tab lit by the
             bar's pill, which slides from one tab to the next. The glass pill and its inner
             gap are on this frame, not on the TabLayout: a fixed TabLayout lays its tabs out
             without its end padding, so the last tab ran under it and its pill was cut square. -->
        <FrameLayout
            android:id="@+id/tab_pill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/watube_nav_inset"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/watube_bottom_nav_background"
            android:padding="5dp">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:tabGravity="fill"
                app:tabIndicator="@drawable/watube_tab_pill"
                app:tabIndicatorAnimationMode="elastic"
                app:tabIndicatorColor="@color/watube_nav_pill"
                app:tabIndicatorFullWidth="true"
                app:tabIndicatorGravity="stretch"
                app:tabMinWidth="0dp"
                app:tabMode="fixed"
                app:tabRippleColor="@android:color/transparent"
                app:tabSelectedTextColor="@color/watube_nav_active"
                app:tabTextAppearance="@style/WatubePillTabLabel"
                app:tabTextColor="?attr/colorOutline" />

        </FrameLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/downloads_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
<!-- endregion -->
