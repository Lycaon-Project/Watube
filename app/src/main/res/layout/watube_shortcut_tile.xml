<?xml version="1.0" encoding="utf-8"?>
<!--
  Solar .qtile shortcut cell of the library screen: accent icon tile plus a
  two line label. One grid column is sized by the row that includes it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/watube_qtile"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="11.5dp"
    android:paddingTop="11dp"
    android:paddingEnd="11.5dp"
    android:paddingBottom="11dp">

    <ImageView
        android:id="@+id/shortcut_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/watube_icon_tile"
        android:importantForAccessibility="no"
        android:padding="7.5dp"
        android:src="@drawable/ic_time_outlined"
        android:tint="@color/watube_nav_active" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/shortcut_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11.3sp"
            android:textStyle="bold"
            tools:text="@string/history" />

        <TextView
            android:id="@+id/shortcut_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOutline"
            android:textSize="9.5sp"
            tools:text="@string/watube_shortcut_downloads" />
    </LinearLayout>
</LinearLayout>
