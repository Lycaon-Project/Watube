<?xml version="1.0" encoding="utf-8"?>
<!-- region Subscriptions -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:paddingHorizontal="8dp"
    android:paddingVertical="6dp"
    android:theme="@style/ThemeOverlay.Watube.GreenTonal">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/subscription_channel_image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:layout_marginStart="8dp"
        app:shapeAppearance="@style/CircleImageView" />

    <TextView
        android:id="@+id/subscription_channel_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        android:textFontWeight="600"
        android:textSize="15sp"
        tools:text="Channel Name" />

    <!-- quiet controls: the row is about the channel, unsubscribing is the rare action -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/notification_bell"
        style="?materialIconButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:contentDescription="@string/notifications"
        android:tooltipText="@string/notifications"
        app:icon="@drawable/ic_notification"
        app:iconTint="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/subscription_subscribe"
        style="?materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginEnd="8dp"
        android:minHeight="40dp"
        android:paddingHorizontal="12dp"
        android:text="@string/unsubscribe"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        app:strokeColor="?attr/colorOutlineVariant" />
</LinearLayout>
<!-- endregion -->
