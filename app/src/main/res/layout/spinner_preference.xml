<?xml version="1.0" encoding="utf-8"?>
<!-- region SponsorBlock -->
<!-- A segment type of SponsorBlock and what to do with it: a settings row (watube_preference),
     the choice under the text. Beside it, the spinner took the width of its longest option and
     left the title a few letters per line on a phone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:paddingStart="13.5dp"
    android:paddingTop="12dp"
    android:paddingEnd="13.5dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@android:id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/watube_pref_title"
        android:textSize="12.4sp"
        android:textStyle="bold"
        tools:text="Sponsor" />

    <TextView
        android:id="@android:id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1.5dp"
        android:textColor="@color/watube_pref_summary"
        android:textSize="10.3sp"
        tools:text="Paid promotion and paid referrals." />

    <!-- the spinner pads its text: pulled back so that it lines up with the title -->
    <Spinner
        android:id="@+id/spinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="-8dp"
        android:layout_marginTop="2dp" />

</LinearLayout>
<!-- endregion -->
