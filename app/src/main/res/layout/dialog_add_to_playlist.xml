<?xml version="1.0" encoding="utf-8"?>
<!-- region Playlists -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.watube.yard.ui.views.DropdownMenu
        android:id="@+id/playlists_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        app:icon="@drawable/ic_playlist_add" />

    <!-- the two actions side by side, end-aligned; when they do not fit on one line (long
         labels, large font) the main one moves to its own line below instead of folding -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:paddingVertical="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/create_playlist"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/createPlaylist" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_to_playlist"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/addToPlaylist" />

        <androidx.constraintlayout.helper.widget.Flow
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="create_playlist,add_to_playlist"
            app:flow_firstHorizontalBias="1"
            app:flow_horizontalBias="1"
            app:flow_horizontalGap="16dp"
            app:flow_horizontalStyle="packed"
            app:flow_lastHorizontalBias="1"
            app:flow_verticalGap="8dp"
            app:flow_wrapMode="chain"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
<!-- endregion -->
