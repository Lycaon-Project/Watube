<?xml version="1.0" encoding="utf-8"?>
<!-- region Privacy -->
<!-- One server of the network record: its name, how many requests went to it (the bar shows
     its share next to the busiest one) and how many the app refused. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/host_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            tools:text="rr4---sn-25ge7nzs.googlevideo.com" />

        <TextView
            android:id="@+id/host_refused"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/watube_refused_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="?attr/colorOnErrorContainer"
            android:textFontWeight="600"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="2 bloquées"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/host_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFeatureSettings="tnum"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            tools:text="128" />

    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/host_share"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="no"
        android:max="1000"
        app:indicatorColor="?attr/colorPrimary"
        app:indicatorTrackGapSize="0dp"
        app:trackStopIndicatorSize="0dp"
        app:trackColor="?attr/colorSurfaceContainerHighest"
        app:trackCornerRadius="2dp"
        app:trackThickness="4dp"
        tools:progress="640" />

</LinearLayout>
<!-- endregion -->
