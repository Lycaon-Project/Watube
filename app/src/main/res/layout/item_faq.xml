<?xml version="1.0" encoding="utf-8"?>
<!-- Expandable FAQ entry (Solar card): a question row with a chevron, and an answer that
     toggles open/closed with an animation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/faq_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/watube_gutter"
    android:layout_marginTop="8dp"
    android:background="@drawable/watube_pcard"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="13dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/faq_question"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/faq_chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_arrow_down"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <TextView
        android:id="@+id/faq_answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.2"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13.5sp"
        android:visibility="gone" />
</LinearLayout>
