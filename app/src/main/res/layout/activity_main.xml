<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    tools:context=".ui.activities.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Watube home header: brand (mark + word) pushed left, action buttons on the
             right (theme / bell / overflow) with a .4rem (5.4dp) gap between them. This
             single sticky row is the only chrome: the overflow button hosts the
             settings/help/about menu, so there is no separate toolbar below it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/watube_gutter"
            android:paddingEnd="@dimen/watube_gutter"
            android:paddingTop="4.7dp">

            <ImageView
                android:layout_width="27.7dp"
                android:layout_height="27.7dp"
                android:background="@drawable/watube_mark_bg"
                android:importantForAccessibility="no"
                android:padding="4.75dp"
                android:scaleType="fitCenter"
                android:src="@drawable/watube_logo" />

            <TextView
                android:id="@+id/brandWord"
                style="@style/WatubeBrandWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7.4dp"
                android:text="@string/app_name" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/themeToggle"
                android:layout_width="@dimen/watube_ib_size"
                android:layout_height="@dimen/watube_ib_size"
                android:layout_marginStart="5.4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tooltip_theme"
                android:padding="8dp"
                android:src="@drawable/watube_moon"
                android:tooltipText="@string/tooltip_theme"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/bellBtn"
                android:layout_width="@dimen/watube_ib_size"
                android:layout_height="@dimen/watube_ib_size"
                android:layout_marginStart="5.4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/notifications"
                android:padding="8dp"
                android:src="@drawable/watube_bell"
                android:tooltipText="@string/notifications"
                app:tint="?attr/colorOnSurfaceVariant" />

            <!-- The app has no user account, so the former profile avatar is replaced by
                 the overflow button that hosts Settings / Help / About (previously the
                 now-removed toolbar's menu). -->
            <ImageButton
                android:id="@+id/overflowBtn"
                android:layout_width="@dimen/watube_ib_size"
                android:layout_height="@dimen/watube_ib_size"
                android:layout_marginStart="5.4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tooltip_more"
                android:padding="8dp"
                android:src="@drawable/ic_three_dots"
                android:tooltipText="@string/tooltip_more"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Adaptive navigation: only used on tablets / unfolded foldables (>= 600dp),
         where MainActivity hides the bottom bar and shows this rail instead.
         It starts below the toolbar so the app bar keeps its full width -->
    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/navRail"
        android:layout_width="80dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurfaceContainer"
        android:visibility="gone"
        app:itemTextAppearanceActive="@style/WatubeBottomNavLabel"
        app:itemTextAppearanceInactive="@style/WatubeBottomNavLabel"
        app:labelMaxLines="1"
        app:labelVisibilityMode="labeled"
        app:paddingTopSystemWindowInsets="false"
        app:contentMarginTop="8dp"
        app:itemSpacing="0dp"
        app:scrollingEnabled="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:menu="@menu/bottom_menu"
        tools:visibility="visible" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:layout_marginStart="@dimen/watube_nav_inset"
        android:layout_marginEnd="@dimen/watube_nav_inset"
        android:background="@drawable/watube_bottom_nav_background"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:itemActiveIndicatorStyle="@style/WatubeBottomNavActiveIndicator"
        app:itemGravity="top_center"
        app:itemIconGravity="top"
        app:itemIconSize="17.3dp"
        app:itemIconTint="@color/watube_bottom_nav_item_tint"
        app:itemPaddingBottom="9.4dp"
        app:itemPaddingTop="9.4dp"
        app:itemTextAppearanceActive="@style/WatubeBottomNavLabel"
        app:itemTextAppearanceInactive="@style/WatubeBottomNavLabel"
        app:itemTextColor="@color/watube_bottom_nav_item_tint"
        app:activeIndicatorLabelPadding="6.5dp"
        app:labelMaxLines="1"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_menu" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout" />

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:elevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
