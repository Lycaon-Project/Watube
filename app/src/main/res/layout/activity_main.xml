<?xml version="1.0" encoding="utf-8"?>
<!-- region Navigation -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    tools:context=".ui.activities.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:outlineProvider="none"
        android:translationZ="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Watube home header: brand (mark + word) pushed left, action buttons on the
             right (theme / bell / overflow) with a .4rem (5.4dp) gap between them. This
             single sticky row is the only chrome: the overflow button hosts the
             settings/help/about menu, so there is no separate toolbar below it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/watube_gutter"
            android:paddingEnd="@dimen/watube_gutter"
            android:paddingTop="4.7dp">

            <ImageView
                android:layout_width="27.7dp"
                android:layout_height="27.7dp"
                android:background="@drawable/watube_mark_bg"
                android:importantForAccessibility="no"
                android:padding="4.75dp"
                android:scaleType="fitCenter"
                android:src="@drawable/watube_logo" />

            <TextView
                android:id="@+id/brandWord"
                style="@style/WatubeBrandWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7.4dp"
                android:text="@string/app_name" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- the three actions in the filled, rounded icons of the bottom bar, 16dp -->
            <ImageButton
                android:id="@+id/themeToggle"
                android:layout_width="@dimen/watube_ib_size"
                android:layout_height="@dimen/watube_ib_size"
                android:layout_marginStart="5.4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tooltip_theme"
                android:padding="8.5dp"
                android:src="@drawable/watube_top_dark"
                android:tooltipText="@string/tooltip_theme"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/bellBtn"
                android:layout_width="@dimen/watube_ib_size"
                android:layout_height="@dimen/watube_ib_size"
                android:layout_marginStart="5.4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_data_maintenance"
                android:padding="8.5dp"
                android:src="@drawable/watube_top_maintenance"
                android:tooltipText="@string/settings_data_maintenance"
                app:tint="?attr/colorOnSurfaceVariant" />

            <!-- The app has no user account, so the former profile avatar is replaced by
                 the overflow button that hosts Settings / Help / About (previously the
                 now-removed toolbar's menu). -->
            <ImageButton
                android:id="@+id/overflowBtn"
                android:layout_width="@dimen/watube_ib_size"
                android:layout_height="@dimen/watube_ib_size"
                android:layout_marginStart="5.4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tooltip_more"
                android:padding="8.5dp"
                android:src="@drawable/watube_top_more"
                android:tooltipText="@string/tooltip_more"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Adaptive navigation: used in every wide window (>= 600dp: a phone turned sideways,
         a tablet), where MainActivity hides the bottom bar and shows this rail instead, so
         the content keeps the whole height. It is the floating bar stood on its side: same
         surface, hairline, corners, shadow, pill and labels, held off the screen edges by the
         same gaps. It starts below the header and only grows as tall as its tabs; on a short
         screen (a phone held sideways with large text) it scrolls instead of hiding a tab.
         MainActivity sets the bottom gap from the system bars.
         It has no menu here: MainActivity builds it only when the rail shows, so a phone
         never spends the time to inflate tabs it cannot see (a fifteenth of a second per
         launch) -->
    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/navRail"
        android:layout_width="@dimen/watube_nav_rail_width"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/watube_nav_inset"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="@dimen/watube_nav_bottom_inset"
        android:paddingBottom="6dp"
        android:background="@drawable/watube_bottom_nav_background"
        android:elevation="6dp"
        android:outlineProvider="none"
        android:visibility="gone"
        app:activeIndicatorLabelPadding="4dp"
        app:collapsedItemMinHeight="48dp"
        app:contentMarginTop="6dp"
        app:itemActiveIndicatorStyle="@style/WatubeBottomNavActiveIndicator"
        app:itemIconSize="17.3dp"
        app:itemIconTint="@color/watube_bottom_nav_item_tint"
        app:itemMinHeight="48dp"
        app:itemPaddingBottom="4dp"
        app:itemPaddingTop="4dp"
        app:itemSpacing="0dp"
        app:itemTextAppearanceActive="@style/WatubeBottomNavLabel"
        app:itemTextAppearanceInactive="@style/WatubeBottomNavLabel"
        app:itemTextColor="@color/watube_bottom_nav_item_tint"
        app:labelMaxLines="1"
        app:labelVisibilityMode="labeled"
        app:menuGravity="top"
        app:paddingBottomSystemWindowInsets="false"
        app:paddingStartSystemWindowInsets="false"
        app:paddingTopSystemWindowInsets="false"
        app:scrollingEnabled="true"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout"
        app:layout_constraintVertical_bias="0"
        tools:menu="@menu/bottom_menu"
        tools:visibility="visible" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:layout_marginStart="@dimen/watube_nav_inset"
        android:layout_marginEnd="@dimen/watube_nav_inset"
        android:background="@drawable/watube_bottom_nav_background"
        android:elevation="6dp"
        android:outlineProvider="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:itemActiveIndicatorStyle="@style/WatubeBottomNavActiveIndicator"
        app:itemGravity="top_center"
        app:itemIconGravity="top"
        app:itemIconSize="17.3dp"
        app:itemIconTint="@color/watube_bottom_nav_item_tint"
        app:itemPaddingBottom="9.4dp"
        app:itemPaddingTop="9.4dp"
        app:itemTextAppearanceActive="@style/WatubeBottomNavLabel"
        app:itemTextAppearanceInactive="@style/WatubeBottomNavLabel"
        app:itemTextColor="@color/watube_bottom_nav_item_tint"
        app:activeIndicatorLabelPadding="6.5dp"
        app:labelMaxLines="1"
        app:labelVisibilityMode="labeled"
        tools:menu="@menu/bottom_menu" />

    <!-- The screens, recorded once per frame for the glass of the bottom bar. They start at
         the top of the window, under the top bar: TopBarOverlay moves each one below it,
         except the screens whose own glass header runs on under it -->
    <com.watube.yard.ui.views.BackdropFrameLayout
        android:id="@+id/backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="true" />
    </com.watube.yard.ui.views.BackdropFrameLayout>

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:elevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
<!-- endregion -->
