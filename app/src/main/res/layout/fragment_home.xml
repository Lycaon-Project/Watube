<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <com.watube.yard.ui.views.CustomSwipeToRefresh
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <!-- Solar search pill: full width, hairline stroke, LOCAL badge on the right -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/search_pill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/watube_gutter"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="@dimen/watube_gutter"
                    android:layout_marginBottom="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="0dp"
                    app:rippleColor="?attr/colorControlHighlight"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="11dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="11dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_search"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/home_search_pill"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:id="@+id/local_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/watube_local_badge"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp">

                            <ImageView
                                android:layout_width="11dp"
                                android:layout_height="11dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_locked"
                                app:tint="?attr/colorOnPrimaryContainer" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:letterSpacing="0.08"
                                android:text="@string/local_badge"
                                android:textColor="?attr/colorOnPrimaryContainer"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Chips de filtres horizontales sous le header (style communautaire) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/filterChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/watube_gutter"
                        android:paddingTop="2dp"
                        android:paddingEnd="@dimen/watube_gutter"
                        android:paddingBottom="12dp"
                        app:chipSpacingHorizontal="7dp"
                        app:singleLine="true" />

                </HorizontalScrollView>

                <!-- Carte héros "À LA UNE" -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/hero_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/watube_gutter"
                    android:layout_marginEnd="@dimen/watube_gutter"
                    android:layout_marginBottom="4dp"
                    android:clipChildren="false"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/hero_card"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="@dimen/watube_card_radius"
                        app:cardElevation="3dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="16:9.6"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeWidth="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/hero_thumb"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <androidx.constraintlayout.widget.Guideline
                                android:id="@+id/hero_scrim_guide"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                app:layout_constraintGuide_percent="0.32" />

                            <View
                                android:id="@+id/hero_scrim"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:background="@drawable/watube_hero_scrim"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="@id/hero_scrim_guide" />

                                <LinearLayout
                                    android:id="@+id/hero_info"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="74dp"
                                    android:paddingBottom="15dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent">

                                <TextView
                                    android:id="@+id/hero_tag"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="7dp"
                                    android:background="@drawable/watube_hero_tag"
                                    android:backgroundTint="?attr/colorPrimary"
                                    android:letterSpacing="0.18"
                                    android:paddingStart="9dp"
                                    android:paddingTop="4dp"
                                    android:paddingEnd="9dp"
                                    android:paddingBottom="4dp"
                                    android:text="@string/home_featured_tag"
                                    android:textColor="?attr/colorOnPrimary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/hero_title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="5dp"
                                    android:ellipsize="end"
                                    android:lineSpacingMultiplier="1.25"
                                    android:maxLines="2"
                                    android:textColor="#FFFFFF"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    tools:text="Pourquoi l’univers n’a pas de centre (et c’est très étrange)" />

                                <TextView
                                    android:id="@+id/hero_meta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:alpha="0.82"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp"
                                    tools:text="CosmOSée · 1,2 M de vues · il y a 2 semaines" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/hero_play"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_marginEnd="14dp"
                                android:layout_marginBottom="14dp"
                                android:contentDescription="@string/tooltip_play"
                                android:elevation="6dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:padding="12dp"
                                app:backgroundTint="?attr/colorPrimary"
                                app:icon="@drawable/ic_play"
                                app:iconGravity="textStart"
                                app:iconPadding="0dp"
                                app:iconTint="?attr/colorOnPrimary"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
                                app:strokeWidth="0dp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Section Reprendre la lecture -->
                <LinearLayout
                    android:id="@+id/watchingTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/watube_cgap"
                    android:background="?selectableItemBackground"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/watching_title"
                        style="@style/HomeCategoryTitle"
                        android:text="@string/home_continue_watching"
                        app:drawableEndCompat="@drawable/ic_arrow_right" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/watchingRV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <!-- Section Pour vous (flux en une seule colonne) -->
                <LinearLayout
                    android:id="@+id/trendingTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/watube_cgap"
                    android:background="?selectableItemBackground"
                    android:orientation="horizontal"
                    android:paddingStart="0dp"
                    android:paddingEnd="3dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/trending_title"
                        style="@style/HomeCategoryTitle"
                        android:text="@string/home_for_you"
                        app:drawableEndCompat="@drawable/ic_arrow_right" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/trending_category"
                        style="?materialIconButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:tooltipText="@string/category"
                        app:icon="@drawable/ic_frame" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/trending_region"
                        style="?materialIconButtonFilledTonalStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="5dp"
                        android:tooltipText="@string/region"
                        app:icon="@drawable/ic_region" />
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:descendantFocusability="blocksDescendants">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/trendingRV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:orientation="vertical"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:visibility="visible" />
                </RelativeLayout>

                <!-- Section Abonnements (featured feed) -->
                <LinearLayout
                    android:id="@+id/featuredTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/watube_cgap"
                    android:background="?selectableItemBackground"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/featured_title"
                        style="@style/HomeCategoryTitle"
                        android:text="@string/subscriptions"
                        app:drawableEndCompat="@drawable/ic_arrow_right" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/featuredRV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:orientation="horizontal"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:visibility="visible" />

                <!-- Section Bibliothèque (bookmarks + playlists) -->
                <LinearLayout
                    android:id="@+id/bookmarksTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/watube_cgap"
                    android:background="?selectableItemBackground"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/bookmarks_title"
                        style="@style/HomeCategoryTitle"
                        android:text="@string/library"
                        app:drawableEndCompat="@drawable/ic_arrow_right" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/bookmarksRV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:visibility="gone"
                    app:layoutManager="com.google.android.material.carousel.CarouselLayoutManager" />

                <LinearLayout
                    android:id="@+id/playlistsTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/watube_cgap"
                    android:background="?selectableItemBackground"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/playlists_title"
                        style="@style/HomeCategoryTitle"
                        android:text="@string/playlists"
                        app:drawableEndCompat="@drawable/ic_arrow_right" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/playlistsRV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:visibility="gone"
                    app:layoutManager="com.google.android.material.carousel.CarouselLayoutManager" />

            </LinearLayout>
        </ScrollView>
    </com.watube.yard.ui.views.CustomSwipeToRefresh>

    <!-- État vide -->
    <LinearLayout
        android:id="@+id/nothing_here"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/listIV"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_list" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/emptyList"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refresh_button"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:text="@string/retry" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/change_instance"
            style="@style/Widget.Material3Expressive.Button"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:text="@string/change_instance" />
    </LinearLayout>

    <com.google.android.material.loadingindicator.LoadingIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        tools:visibility="gone" />
</FrameLayout>
