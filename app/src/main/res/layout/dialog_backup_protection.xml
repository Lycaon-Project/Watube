<?xml version="1.0" encoding="utf-8"?>
<!-- region Backup & Restore -->
<!-- What will open the backup: a password chosen by the user, or a recovery code created by
     the app. The backup is encrypted either way. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:text="@string/backup_protect_message"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <RadioGroup
            android:id="@+id/backup_protection_choice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checkedButton="@id/backup_protect_password"
            android:paddingHorizontal="12dp">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/backup_protect_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/password"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="44dp"
                android:layout_marginTop="-8dp"
                android:layout_marginBottom="4dp"
                android:importantForAccessibility="no"
                android:text="@string/backup_protect_password_summary"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/backup_protect_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/backup_protect_code"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="44dp"
                android:layout_marginTop="-8dp"
                android:importantForAccessibility="no"
                android:text="@string/backup_protect_code_summary"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </RadioGroup>

        <LinearLayout
            android:id="@+id/backup_password_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/backup_password_layout"
                style="@style/CustomDialogTextInputLayout"
                android:hint="@string/password"
                app:endIconMode="password_toggle"
                app:helperTextEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/backup_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:imeOptions="flagNoPersonalizedLearning|actionNext"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/backup_password_confirm_layout"
                style="@style/CustomDialogTextInputLayout"
                android:hint="@string/backup_password_confirm"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/backup_password_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:imeOptions="flagNoPersonalizedLearning|actionDone"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:drawablePadding="8dp"
                android:paddingHorizontal="24dp"
                android:text="@string/backup_password_manager_note"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                app:drawableStartCompat="@drawable/ic_shield"
                app:drawableTint="?attr/colorPrimary" />

        </LinearLayout>

        <TextView
            android:id="@+id/backup_code_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:paddingHorizontal="24dp"
            android:text="@string/backup_code_warning"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
<!-- endregion -->
