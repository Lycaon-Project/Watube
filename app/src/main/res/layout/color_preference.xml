<?xml version="1.0" encoding="utf-8"?>
<!-- region Appearance -->
<!-- The color of a segment type in the seek bar: a settings row (watube_preference) with the
     color at its end. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="13.5dp"
    android:paddingTop="12dp"
    android:paddingEnd="13.5dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@android:id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/watube_pref_title"
        android:textSize="12.4sp"
        android:textStyle="bold"
        tools:text="Sponsor" />

    <View
        android:id="@+id/circle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/circle"
        android:importantForAccessibility="no" />

</LinearLayout>
<!-- endregion -->
