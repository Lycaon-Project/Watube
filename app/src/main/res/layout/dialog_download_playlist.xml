<?xml version="1.0" encoding="utf-8"?>
<!-- region Downloads -->
<!-- Download sheet of a playlist (DownloadPlaylistDialog), in two steps: tick the videos, Next,
     then one format for all of them. Only the video playing starts ticked. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Step 1: the videos -->
    <LinearLayout
        android:id="@+id/step_videos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/watube_gutter"
        android:paddingBottom="16dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/playlist_title"
            style="@style/WatubeSheetTitle"
            android:layout_width="match_parent"
            android:accessibilityHeading="true"
            tools:text="Chill mix" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/selection_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:fontFeatureSettings="tnum"
                android:text="@string/download_choose_videos"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggle_all"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="-12dp"
                android:enabled="false"
                android:minHeight="48dp"
                android:text="@string/download_select_all" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/video_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="vertical" />

            <LinearLayout
                android:id="@+id/videos_skeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginVertical="6dp"
                    android:background="@drawable/watube_download_skeleton" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginVertical="6dp"
                    android:background="@drawable/watube_download_skeleton" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginVertical="6dp"
                    android:background="@drawable/watube_download_skeleton" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/videos_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/videos_error_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="@string/download_playlist_empty" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/videos_retry"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/retry" />

            </LinearLayout>

        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/next_button"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="@string/download_next" />

    </LinearLayout>

    <!-- Step 2: one format for every ticked video -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/step_format"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/watube_gutter"
            android:paddingBottom="16dp">

            <com.google.android.material.bottomsheet.BottomSheetDragHandleView
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/back_button"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="-12dp"
                    android:contentDescription="@string/download_back_to_videos"
                    android:tooltipText="@string/download_back_to_videos"
                    app:icon="@drawable/watube_chevron_left" />

                <TextView
                    android:id="@+id/format_title"
                    style="@style/WatubeSheetTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:fontFeatureSettings="tnum"
                    tools:text="Chill mix" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/format_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:checkedButton="@+id/format_video"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/format_video"
                    style="@style/WatubeDownloadToggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/video"
                    app:icon="@drawable/ic_video" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/format_audio"
                    style="@style/WatubeDownloadToggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/download_audio_only"
                    app:icon="@drawable/ic_audio" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/playlist_quality_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-5dp"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                style="@style/WatubeLinkNote"
                android:text="@string/download_playlist_quality_note"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playlist_more_options"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="@string/download_more_options"
                app:icon="@drawable/ic_arrow_down"
                app:iconGravity="end" />

            <LinearLayout
                android:id="@+id/playlist_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.watube.yard.ui.views.DropdownMenu
                    android:id="@+id/audio_language_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hint="@string/audio_language"
                    app:icon="@drawable/ic_region" />

                <com.watube.yard.ui.views.DropdownMenu
                    android:id="@+id/subtitle_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hint="@string/captions"
                    app:icon="@drawable/ic_caption" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/playlist_download_button"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:fontFeatureSettings="tnum"
                android:text="@string/download"
                app:icon="@drawable/ic_download"
                app:iconGravity="textStart" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>
<!-- endregion -->
