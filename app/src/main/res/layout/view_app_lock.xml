<?xml version="1.0" encoding="utf-8"?>
<!-- region Privacy -->
<!-- Cover of the app lock: it hides the screen below and takes every touch until unlocked. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_lock_cover"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:clickable="true"
    android:elevation="32dp"
    android:focusable="true"
    android:importantForAccessibility="yes">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:importantForAccessibility="no"
            android:src="@drawable/watube_splash_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/app_lock_locked"
            android:textColor="?attr/colorOnSurface"
            android:textFontWeight="700"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/app_lock_locked_summary"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/app_lock_unlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/app_lock_unlock" />

    </LinearLayout>

</FrameLayout>
<!-- endregion -->
