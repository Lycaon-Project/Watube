<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <integer name="grid_items">1</integer>
    <integer name="grid_items_landscape">2</integer>

    <!-- Solar spacing: pad (1.1rem) and cgap (1.15rem) of the mockup -->
    <dimen name="watube_gutter">15dp</dimen>
    <dimen name="watube_cgap">15dp</dimen>
    <dimen name="watube_card_radius">17.5dp</dimen>
    <dimen name="watube_nav_inset">10dp</dimen>
    <!-- Collapsed mini player: 56dp card holding a 16:9 video inset by 6dp, whose corner
         radius is the card radius minus the inset so both curves stay concentric. -->
    <dimen name="watube_mini_player_margin_start">@dimen/watube_nav_inset</dimen>
    <dimen name="watube_mini_player_height">56dp</dimen>
    <dimen name="watube_mini_player_video_inset">6dp</dimen>
    <dimen name="watube_mini_player_video_height">44dp</dimen>
    <dimen name="watube_mini_player_video_width">78dp</dimen>
    <dimen name="watube_mini_player_video_radius">11.5dp</dimen>
    <!-- Floating bar offset from the screen bottom: kept clear of the physical screen
         edge / gesture area so nothing is clipped by rounded device corners. -->
    <dimen name="watube_nav_bottom_inset">22dp</dimen>

    <!-- Mockup chip geometry: .42rem/.95rem padding and .83rem label (visual pill
         height, the 48dp touch target is added by Chip itself) -->
    <dimen name="watube_chip_min_height">27dp</dimen>
    <dimen name="watube_chip_h_padding">13dp</dimen>
    <!-- Mockup .ib: 2.45rem circle -->
    <dimen name="watube_ib_size">33dp</dimen>

    <!-- Fullscreen player: offset between the bottom edge of the player controls and the
         bottom control cluster (seekbar row). Declared as a dimen so the value is resolved
         through the app Resources configuration of the current screen instead of being
         converted from dp in code. The camera cutout is kept clear by the side margins
         (CustomExoPlayerView.updateMarginsByFullscreenMode), not by this offset. -->
    <dimen name="watube_player_controls_fullscreen_bottom_margin">10dp</dimen>
    <!-- Media3's PlayerControlViewLayoutManager gives the time bar this bottom margin (52dp in
         Media3) whenever the player is large enough, i.e. in fullscreen landscape: the whole
         bottom cluster then floated far above the edge. The layout spaces it itself. -->
    <dimen name="exo_styled_progress_margin_bottom" tools:override="true" tools:ignore="UnusedResources">0dp</dimen>

    <item name="landscape_player_constraint_width_percentage" type="dimen" format="float">0.55</item>
    <!-- subscriptions rail: one channel column, its ringed avatar -->
    <dimen name="watube_rail_item_width">72dp</dimen>
    <dimen name="watube_rail_avatar_size">58dp</dimen>
    <dimen name="watube_rail_ring">2dp</dimen>
    <dimen name="watube_rail_ring_selected">2.5dp</dimen>
</resources>
