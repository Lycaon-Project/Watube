    <!-- Help page -->
    <string name="help_intro">Everything you need to get the most out of Watube — a private, account-free way to watch.</string>
    <string name="help_faq_title">Frequently asked questions</string>
    <string name="help_tips_title">Getting started</string>
    <string name="help_q_account">Do I need an account?</string>
    <string name="help_a_account">No. Watube works entirely without any account or sign-in. Your subscriptions, history and playlists stay on your device.</string>
    <string name="help_q_local">What is full local mode?</string>
    <string name="help_a_local">In full local mode the app fetches everything directly, without going through any third-party server. It is the most private way to use Watube.</string>
    <string name="help_q_download">How do I download a video?</string>
    <string name="help_a_download">Open a video, then tap Download in the action row under the player. Downloads are available offline from the Library tab.</string>
    <string name="help_q_sponsorblock">What is SponsorBlock?</string>
    <string name="help_a_sponsorblock">SponsorBlock automatically skips sponsored segments, intros and other interruptions, using a community database. You can configure it in Settings.</string>
    <string name="help_q_privacy">How does Watube protect my privacy?</string>
    <string name="help_a_privacy">Watube sends no personal identifiers, rotates anonymous identifiers, can request a neutral region, and hardens its embedded WebView. See Settings → Privacy.</string>
    <string name="help_q_backup">Can I back up my data?</string>
    <string name="help_a_backup">Yes. Settings → Data &amp; maintenance → Backup lets you export and restore your subscriptions, playlists and history.</string>
    <string name="help_tip_search_title">Search</string>
    <string name="help_tip_search">Tap the search bar on the home screen. You can also paste a YouTube link to open it directly.</string>
