<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Watube signature shapes: Solar radii (8 / 12 / 17.5 dp) -->
    <style name="WatubeShape.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="WatubeShape.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="WatubeShape.Large" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">17.5dp</item>
    </style>

    <style name="WatubeShape.Pill" parent="ShapeAppearance.Material3.Corner.Full" />

    <!-- Solar bottom navigation: accent-soft pill behind the selected item -->
    <style name="WatubeNavActiveIndicator"
        parent="Widget.Material3Expressive.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
        <item name="shapeAppearance">@style/WatubeShape.Pill</item>
    </style>

    <!-- Bottom bar only: 3.4rem x 1.85rem pill of the mockup (.nic), centered on the icon -->
    <style name="WatubeBottomNavActiveIndicator"
        parent="Widget.Material3Expressive.BottomNavigationView.ActiveIndicator">
        <item name="android:width">46dp</item>
        <item name="android:height">25dp</item>
        <item name="android:color">@color/watube_nav_pill</item>
        <item name="shapeAppearance">@style/WatubeShape.Pill</item>
    </style>

    <!-- Bottom bar labels: .64rem / 700 of the mockup (.bnav button), single line -->
    <style name="WatubeBottomNavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">8.6sp</item>
        <item name="android:lineHeight">10sp</item>
        <item name="lineHeight">10sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RoundedImageView">

        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8%</item>

    </style>

    <style name="CircleImageView">

        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>

    </style>

    <style name="AboutCard" parent="Widget.Material3.CardView.Elevated">

        <item name="android:layout_marginStart">@dimen/watube_gutter</item>
        <item name="android:layout_marginEnd">@dimen/watube_gutter</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">@dimen/watube_card_radius</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardElevation">0dp</item>

    </style>

    <style name="AboutItem">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
    </style>

    <!-- Solar sheet heading: compact bold title over a divider -->
    <style name="WatubeSheetTitle">

        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>

    </style>

    <style name="CustomDialogTextInputLayout" parent="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">15dp</item>
        <item name="android:layout_marginEnd">15dp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginBottom">10dp</item>

    </style>

    <style name="DisabledTextInput">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:editable">false</item>
        <item name="android:textIsSelectable">true</item>

    </style>

    <!-- Solar .act: pill action with chip surface + hairline stroke -->
    <style name="PlayerActionsButton" parent="@style/Widget.Material3.Button.ElevatedButton">

        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">3.5dp</item>
        <item name="android:layout_marginEnd">3.5dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textSize">10.75sp</item>
        <item name="android:textStyle">bold</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">14dp</item>
        <item name="iconPadding">6dp</item>
        <item name="shapeAppearance">@style/WatubeShape.Pill</item>
        <item name="backgroundTint">?attr/colorSurfaceContainer</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurfaceVariant</item>

    </style>

    <style name="PlayerControlBottom">

        <item name="android:padding">9dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>

    </style>

    <style name="PlayerControlCenter">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginEnd">0dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="PlayerControlTop">

        <item name="android:padding">9dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@android:color/white</item>

    </style>

    <style name="WatchProgress">

        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">4dp</item>
        <item name="android:background">?attr/colorPrimary</item>
        <item name="android:visibility">gone</item>

    </style>

    <style name="TimeString">
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textSize">9.1sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:shadowColor">#99000000</item>
        <item name="android:shadowRadius">4</item>
        <item name="android:shadowDy">1</item>
    </style>

    <!-- Solar .pchip: dark scrim pill over the video, hairline stroke, 8.9sp bold -->
    <style name="WatubePlayerChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/watube_player_chip</item>
        <item name="android:paddingStart">7.5dp</item>
        <item name="android:paddingEnd">7.5dp</item>
        <item name="android:paddingTop">3.5dp</item>
        <item name="android:paddingBottom">3.5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">8.9sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SwipeControlString">
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lines">1</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:text">0</item>
    </style>

    <!-- Solar chips: chip token (#242932 + hairline) that turns accent on selection -->
    <style name="Watube.Chip" parent="Widget.Material3.Chip.Filter">

        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>

        <item name="shapeAppearance">@style/WatubeShape.Pill</item>
        <item name="chipBackgroundColor">@color/watube_chip_bg</item>
        <item name="chipStrokeColor">@color/watube_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/watube_chip_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:elevation">0dp</item>

    </style>

    <style name="Watube.Chip.Elevated" parent="Watube.Chip">

        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>

    </style>

    <style name="Chip" parent="Watube.Chip">

        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>

    </style>

    <style name="ItemRow">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">@drawable/rounded_ripple</item>
        <item name="android:orientation">horizontal</item>

    </style>

    <!-- Uses Material Switches instead of the old ones -->
    <style name="Preference.SwitchPreferenceCompat.Material3" parent="@style/Preference.SwitchPreferenceCompat.Material">

        <item name="widgetLayout">@layout/view_preference_switch</item>
        <item name="singleLineTitle">false</item>

    </style>

    <style name="snackBarStyle" parent="@style/Widget.Material3.Snackbar">
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.ExtraLarge</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="maxLines">2</item>
        <item name="animationMode">slide</item>
    </style>

    <!-- Solar section heading: accent tick + compact bold title -->
    <style name="HomeCategoryTitle">

        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:drawableStart">@drawable/watube_section_tick</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:paddingStart">@dimen/watube_gutter</item>

    </style>

    <style name="TextViewMarquee">

        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>
        <item name="android:scrollHorizontally">true</item>
        <item name="android:textAlignment">center</item>

    </style>

    <style name="ElevatedFilterChip" parent="Watube.Chip.Elevated">

        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>

    </style>

    <!-- Mockup .shd h1: Bricolage Grotesque 800 / 1.62rem with -.02em tracking, the
         screen title of Bibliothèque, Paramètres, Abonnements and the other panes.
         Bricolage Grotesque is not shipped with the app, so the label falls back to
         the theme typeface; textFontWeight 800 is applied when the platform honours
         it and textStyle bold is the guaranteed floor. -->
    <style name="WatubeScreenTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">800</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Abonnements keeps its own name for the shared .shd h1 appearance. -->
    <style name="WatubeSubsTitle" parent="WatubeScreenTitle" />

    <!-- Mockup .phead h2: 1.25rem / 800 / -.02em, the title of a settings pane.
         MainSettings keeps .shd h1 through the toolbar, the sub panes use this one. -->
    <style name="WatubePaneTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">800</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Mockup .slab of the search pane: .68rem / 800 / .16em tracking, uppercase,
         t3 ink. -->
    <style name="WatubeSectionLabel">
        <item name="android:textSize">9.2sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">800</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/colorOutline</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Mockup .slab .deb: same size, 700, no tracking, no upper casing, acc ink. -->
    <style name="WatubeSectionLabelNote">
        <item name="android:textSize">9.2sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/watube_nav_active</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Mockup .word of the home header: Bricolage Grotesque 800 / 1.32rem with -.03em
         tracking. Bricolage Grotesque is not shipped with the app, so the label falls
         back to the theme typeface; textFontWeight 800 is applied when the platform
         honours it and textStyle bold is the guaranteed floor. The 95deg
         acc-text to acc gradient is painted by MainActivity. -->
    <style name="WatubeBrandWord">
        <item name="android:textSize">17.8sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">800</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/watube_nav_active</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Mockup .chip label (.83rem / w600). Only the size is overridden: Material's
         TextAppearance drives the Chip paint from this appearance, so keeping the
         LabelLarge family is what preserves the medium weight, and no colour is set
         here so @color/watube_chip_text (t2 -> acc-ink) stays in charge. -->
    <style name="WatubeChipLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">11.2sp</item>
    </style>

    <!-- Mockup .chip geometry for the Abonnements group chips: 27dp pill with the
         .95rem horizontal inset. Kept out of Watube.Chip on purpose, the search and
         watch history chips keep their own metrics. -->
    <style name="Watube.Chip.Subs" parent="ElevatedFilterChip">
        <item name="chipMinHeight">@dimen/watube_chip_min_height</item>
        <item name="chipStartPadding">0dp</item>
        <item name="textStartPadding">@dimen/watube_chip_h_padding</item>
        <item name="textEndPadding">@dimen/watube_chip_h_padding</item>
        <item name="chipEndPadding">0dp</item>
        <item name="android:textAppearance">@style/WatubeChipLabel</item>
    </style>

    <style name="Widget.Material3.Button.IconButton.Elevated" parent="Widget.Material3.Button.IconButton">
        <item name="android:stateListAnimator">@animator/m3_btn_elevated_btn_state_list_anim</item>
        <item name="elevation">@dimen/m3_comp_button_elevated_container_elevation</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Material3Expressive.Button.Elevated</item>
    </style>

    <style name="AlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Material3.Button.OutlinedButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Material3.Button.OutlinedButton</item>
    </style>

    <style name="PositiveButton" parent="Widget.Material3.Button">
        <item name="android:layout_marginStart">16dp</item>
    </style>

    <!-- Font option (Settings > Appearance): applied as a theme overlay so that every
         view inheriting the theme picks it up. "system" (default) applies nothing. -->
    <style name="WatubeFontFigtree">
        <item name="android:fontFamily">@font/figtree</item>
    </style>

</resources>