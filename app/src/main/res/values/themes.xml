<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="BaseTheme" parent="Theme.Material3Expressive.Light.NoActionBar">

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">true</item>

        <item name="switchPreferenceCompatStyle">
            @style/Preference.SwitchPreferenceCompat.Material3
        </item>

        <item name="snackbarStyle">@style/snackBarStyle</item>

        <item name="loadingIndicatorStyle">@style/Widget.Material3.LoadingIndicator.Contained</item>

        <item name="materialAlertDialogTheme">@style/AlertDialogTheme</item>

        <!-- Watube signature shapes -->
        <item name="shapeAppearanceSmallComponent">@style/WatubeShape.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/WatubeShape.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/WatubeShape.Large</item>

        <!-- Solar navigation: accent-soft pill behind the selected item -->
        <item name="itemActiveIndicatorStyle">@style/WatubeNavActiveIndicator</item>

        <!-- Solar chips: flat surface chip everywhere, including chips created
             from the plain Material Chip style. -->
        <item name="chipStyle">@style/Chip</item>
    </style>

    <style name="SplashScreenTheme" parent="Theme.SplashScreen">

        <!-- Watube: use the real app logo (re-adapted for the splash screen) instead of
             the old LibreTube play-button vector. Icon is masked into a circle by the
             splash screen API, hence the dedicated circular drawable. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/watube_splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">#08140E</item>
        <item name="android:windowBackground">@color/watube_splash_background</item>
        <item name="postSplashScreenTheme">@style/BaseTheme</item>

    </style>

    <style name="Theme.Watube" parent="BaseTheme">

        <item name="colorPrimary">@color/watube_theme_light_primary</item>
        <item name="colorOnPrimary">@color/watube_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/watube_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/watube_theme_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/watube_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/watube_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/watube_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/watube_theme_light_onSecondaryContainer</item>
        <item name="colorTertiary">@color/watube_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/watube_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/watube_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/watube_theme_light_onTertiaryContainer</item>
        <item name="colorError">@color/watube_theme_light_error</item>
        <item name="colorErrorContainer">@color/watube_theme_light_errorContainer</item>
        <item name="colorOnError">@color/watube_theme_light_onError</item>
        <item name="colorOnErrorContainer">@color/watube_theme_light_onErrorContainer</item>
        <item name="android:colorBackground">@color/watube_theme_light_background</item>
        <item name="colorOnBackground">@color/watube_theme_light_onBackground</item>
        <item name="colorSurface">@color/watube_theme_light_surface</item>
        <item name="colorOnSurface">@color/watube_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/watube_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/watube_theme_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/watube_theme_light_outline</item>
        <item name="colorOnSurfaceInverse">@color/watube_theme_light_inverseOnSurface</item>
        <item name="colorSurfaceInverse">@color/watube_theme_light_inverseSurface</item>
        <item name="colorPrimaryInverse">@color/watube_theme_light_inversePrimary</item>

        <item name="colorSurfaceContainerLowest">@color/watube_theme_light_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/watube_theme_light_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/watube_theme_light_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/watube_theme_light_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/watube_theme_light_surfaceContainerHighest</item>
        <item name="colorSurfaceDim">@color/watube_theme_light_surfaceDim</item>
        <item name="colorSurfaceBright">@color/watube_theme_light_surfaceBright</item>
        <item name="colorOutlineVariant">@color/watube_theme_light_outlineVariant</item>

        <!-- Day mode is a light surface: status/navigation bar icons stay dark. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">true</item>

    </style>




    <style name="Pure">

        <!-- Flat white surfaces. The neutral roles must be flipped back to a light
             palette here: every Watube accent ships with dark-grey neutrals. -->
        <item name="android:colorBackground">@android:color/white</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#FAFAFA</item>
        <item name="colorSurfaceContainer">#FFFFFF</item>
        <item name="colorSurfaceContainerHigh">#F2F2F2</item>
        <item name="colorSurfaceContainerHighest">#EAEAEA</item>
        <item name="colorSurfaceDim">#FFFFFF</item>
        <item name="colorSurfaceBright">#FFFFFF</item>
        <item name="colorSurfaceVariant">#E8E8E8</item>
        <item name="colorOnSurface">#1A1C1E</item>
        <item name="colorOnBackground">#1A1C1E</item>
        <item name="colorOnSurfaceVariant">#444746</item>
        <item name="colorOutline">#74777C</item>
        <item name="colorOutlineVariant">#C4C6CA</item>
        <item name="colorSurfaceInverse">#33373A</item>
        <item name="colorOnSurfaceInverse">#ECEFF1</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:ignore="NewApi">true</item>
        <item name="popupMenuBackground">@drawable/pure_theme_popup_menu_background</item>

    </style>

    <style name="DialogActivity">

        <item name="android:colorBackground">?attr/colorBackgroundFloating</item>
        <item name="android:colorBackgroundCacheHint">@null</item>

        <item name="android:windowFrame">@null</item>
        <item name="android:windowTitleStyle">@style/RtlOverlay.DialogWindowTitle.AppCompat</item>
        <item name="android:windowTitleBackgroundStyle">@style/Base.DialogWindowTitleBackground.AppCompat</item>
        <item name="android:windowBackground">@drawable/abc_dialog_material_background</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/Animation.AppCompat.Dialog</item>
        <item name="android:windowSoftInputMode">stateUnspecified|adjustPan</item>

        <item name="windowActionBar">false</item>
        <item name="windowActionModeOverlay">true</item>

        <item name="listPreferredItemPaddingLeft">24dip</item>
        <item name="listPreferredItemPaddingRight">24dip</item>

        <item name="android:listDivider">@null</item>

        <item name="android:buttonBarStyle">@style/Widget.AppCompat.ButtonBar.AlertDialog</item>
        <item name="android:borderlessButtonStyle">@style/Widget.AppCompat.Button.Borderless</item>
        <item name="android:windowCloseOnTouchOutside">true</item>

    </style>

</resources>