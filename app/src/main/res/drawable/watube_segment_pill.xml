<?xml version="1.0" encoding="utf-8"?>
<!--
  Pill under the chosen button of the Video / Audio switch (SlidingToggle): the same soft green
  as the selected tab of the Downloads page (watube_nav_pill), inset inside the track so the
  hairline stays around it.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="4dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/watube_nav_pill" />
        <!-- clamped to half the height: a full pill -->
        <corners android:radius="999dp" />
    </shape>
</inset>
