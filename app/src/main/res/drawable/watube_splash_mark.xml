    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="240"
    android:viewportHeight="240">

    <path
        android:fillColor="@color/watube_mark_bg"
        android:pathData="M104.4,68h31.2a36.4,36.4 0,0 1,36.4 36.4v31.2a36.4,36.4 0,0 1,-36.4 36.4h-31.2a36.4,36.4 0,0 1,-36.4 -36.4v-31.2a36.4,36.4 0,0 1,36.4 -36.4z" />

    <group
        android:scaleX="2.847"
        android:scaleY="2.847"
        android:translateX="85.84"
        android:translateY="85.84">
