<?xml version="1.0" encoding="utf-8"?>
<!--
  Track of the Video / Audio switch of the download sheets (SlidingToggle): the chips' surface
  and hairline, rounded into a pill. The accent pill slides inside it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/watube_chip_fill" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />
    <!-- clamped to half the height: a full pill -->
    <corners android:radius="999dp" />
</shape>
