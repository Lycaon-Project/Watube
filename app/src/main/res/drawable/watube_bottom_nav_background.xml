<?xml version="1.0" encoding="utf-8"?>
<!--
  Solar bottom navigation (day): floating bar, hairline stroke, 1.9rem corners on all
  four sides, fill rgba(250,250,247,.94) so the page tint shows through the gap below.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/watube_nav_scrim" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />
    <corners android:radius="25dp" />
</shape>
