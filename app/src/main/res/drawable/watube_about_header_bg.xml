<?xml version="1.0" encoding="utf-8"?>
<!--
  About header card (.aboutcard of the mockup): one flat, faint wash of the accent over
  the page (no gradient), edged by a hairline of the same accent, r-l corner radius.
  Colours are theme attributes so every accent / light / dark theme resolves.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/watube_about_header_fill" />
    <corners android:radius="@dimen/watube_card_radius" />
    <stroke
        android:width="1dp"
        android:color="@color/watube_about_header_stroke" />
</shape>
