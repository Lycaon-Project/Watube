<?xml version="1.0" encoding="utf-8"?>
<!--
  About header card (.aboutcard of the mockup): accent-soft gradient (135deg)
  landing on the theme surface, hairline stroke, r-l corner radius.
  Colours are theme attributes so every accent / light / dark theme resolves.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:endColor="?attr/colorSurface"
        android:startColor="?attr/colorPrimaryContainer"
        android:type="linear" />
    <corners android:radius="@dimen/watube_card_radius" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />
</shape>
