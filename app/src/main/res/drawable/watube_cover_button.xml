<?xml version="1.0" encoding="utf-8"?>
<!-- Round button laid over a cover image (back, bookmark): the dark scrim keeps the icon
     readable on any picture, and the press ripple stays inside the circle instead of
     spreading past it. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:drawable="@drawable/watube_cover_scrim" />
</ripple>
