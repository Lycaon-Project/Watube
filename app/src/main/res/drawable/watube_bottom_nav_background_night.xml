<?xml version="1.0" encoding="utf-8"?>
<!--
  Solar bottom navigation (night): the day glass pill in dark glass, the mockup dark nav
  tone at 84 % (watube_nav_scrim_night), with the same narrow sheen,
  kept faint so the pill stays dark (values-night is outside the editable resource set,
  so the night pill is picked at runtime from MainActivity).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- the plain fill, swapped for the smart tint while the glass is on (GlassBackground) -->
    <item android:id="@+id/watube_glass_fill">
        <shape android:shape="rectangle">
            <solid android:color="@color/watube_nav_scrim_night" />
            <corners android:radius="25dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerY="0.3"
                android:startColor="#0DFFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="25dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="?attr/colorOutlineVariant" />
            <corners android:radius="25dp" />
        </shape>
    </item>
</layer-list>
