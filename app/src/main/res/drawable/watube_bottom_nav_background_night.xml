<?xml version="1.0" encoding="utf-8"?>
<!--
  Solar bottom navigation (night): same floating bar as the day drawable, filled with
  the night scrim (values-night is outside the editable resource set, so the night fill
  is picked at runtime from MainActivity).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/watube_nav_scrim_night" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />
    <corners android:radius="25dp" />
</shape>
