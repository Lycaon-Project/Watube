<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!--
      Cleartext (http://) traffic is only allowed towards the local machine, so that
      self-hosted instances running on the emulator or on localhost keep working.
      Everything else must be encrypted, which also protects the PoToken WebView
      and all API calls from man-in-the-middle injection.
    -->
    <base-config
        cleartextTrafficPermitted="false"
        tools:ignore="CleartextTrafficPermitted">
        <trust-anchors>
            <!-- Trust preinstalled CAs -->
            <certificates src="system" />
            <!-- Additionally trust user added CAs (self-signed local instances) -->
            <certificates
                src="user"
                tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
