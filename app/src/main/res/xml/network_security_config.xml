<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!--
      Cleartext (http://) traffic is only allowed towards the local machine, so that
      self-hosted instances running on the emulator or on localhost keep working.
      Everything else must be encrypted, which also protects the PoToken WebView
      and all API calls from man-in-the-middle injection.
    -->
    <base-config
        cleartextTrafficPermitted="false"
        tools:ignore="CleartextTrafficPermitted">
        <trust-anchors>
            <!-- Trust preinstalled CAs only. User installed CAs are deliberately NOT
                 trusted in release: any app (or MDM) could install one and read the whole
                 traffic. The debug build overrides this file with a version that does
                 trust user CAs, so mitmproxy/Charles based diagnostics keep working. -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
