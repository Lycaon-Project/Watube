<?xml version="1.0" encoding="utf-8"?>
<!-- region Privacy -->
<!--
  Android 12+ backup / device-to-device transfer rules.

  Privacy line of this app: nothing is uploaded to a cloud backup service (allowBackup is off
  in the manifest, and every domain is excluded here as well, since some devices still read
  these rules). A local device-to-device transfer keeps the settings and the library, and the
  in-app export (Settings -> Backup) remains the supported way to save a copy of everything.

  Credentials (Piped auth token, login data) and crash logs (they can contain video ids and
  urls) never leave the device at all.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="root"
            path="." />
        <exclude
            domain="file"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="external"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="auth.xml" />
        <exclude
            domain="sharedpref"
            path="errors.xml" />
    </device-transfer>
</data-extraction-rules>
<!-- endregion -->
