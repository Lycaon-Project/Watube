<?xml version="1.0" encoding="utf-8"?>
<!-- region Settings -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/maintenance">

        <!-- region Backup & Restore -->
        <Preference
            android:icon="@drawable/ic_backup"
            app:key="backup_restore"
            app:summary="@string/backup_restore_summary"
            app:title="@string/backup_restore" />
        <!-- endregion -->

        <Preference
            android:icon="@drawable/ic_delete"
            app:key="clear_cache"
            app:summary="@string/clear_cache_summary"
            app:title="@string/clear_cache" />

        <!-- The manual update check lives in the About screen only, to avoid duplication. -->

        <!-- region Crash Reports -->
        <Preference
            android:icon="@drawable/ic_info"
            app:key="crashlog"
            app:title="@string/crashlog" />
        <!-- endregion -->

    </PreferenceCategory>

</PreferenceScreen>
<!-- endregion -->
