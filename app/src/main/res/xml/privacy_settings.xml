<?xml version="1.0" encoding="utf-8"?>
<!-- region Privacy -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Anti-fingerprinting / anti-tracking measures (see PrivacyHelper) -->
    <PreferenceCategory app:title="@string/privacy_category_protection">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="privacy_hardening"
            app:summary="@string/privacy_hardening_summary"
            app:title="@string/privacy_hardening" />

        <ListPreference
            app:defaultValue="24h"
            app:dependency="privacy_hardening"
            app:entries="@array/privacyRotationFrequency"
            app:entryValues="@array/privacyRotationFrequencyValues"
            app:key="privacy_rotation_frequency"
            app:title="@string/privacy_rotation_frequency" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:dependency="privacy_hardening"
            app:key="privacy_neutral_region"
            app:summary="@string/privacy_neutral_region_summary"
            app:title="@string/privacy_neutral_region" />

        <!-- countries filled and shown by PrivacySettings while the rotation is manual -->
        <ListPreference
            app:defaultValue="GB"
            app:dependency="privacy_neutral_region"
            app:isPreferenceVisible="false"
            app:key="privacy_neutral_region_country"
            app:title="@string/privacy_neutral_region_country" />

        <!-- DNS-over-HTTPS for every request of the app (util/PrivateDns.kt) -->
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="private_dns"
            app:summary="@string/private_dns_summary"
            app:title="@string/private_dns" />

        <ListPreference
            app:defaultValue="quad9"
            app:dependency="private_dns"
            app:entries="@array/privateDnsResolver"
            app:entryValues="@array/privateDnsResolverValues"
            app:key="private_dns_resolver"
            app:title="@string/private_dns_resolver"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="tourist_mode"
            app:summary="@string/tourist_mode_summary"
            app:title="@string/tourist_mode" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="app_lock"
            app:summary="@string/app_lock_summary"
            app:title="@string/app_lock" />

        <ListPreference
            app:defaultValue="0"
            app:dependency="app_lock"
            app:entries="@array/app_lock_delay_entries"
            app:entryValues="@array/app_lock_delay_values"
            app:key="app_lock_delay"
            app:title="@string/app_lock_delay"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="hide_lockscreen_content"
            app:summary="@string/watube_hide_lockscreen_summary"
            app:title="@string/watube_hide_lockscreen" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="hide_recents_preview"
            app:summary="@string/watube_hide_recents_summary"
            app:title="@string/watube_hide_recents" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="block_screenshots"
            app:summary="@string/watube_block_screenshots_summary"
            app:title="@string/watube_block_screenshots" />

    </PreferenceCategory>

    <!-- Rotating client-side identifiers -->
    <PreferenceCategory app:title="@string/privacy_identifiers">

        <!-- region SponsorBlock -->
        <Preference
            app:key="sb_user_id_info"
            app:selectable="false"
            app:summary="@string/sb_user_id_info"
            app:title="@string/current_sponsorblock_id" />
        <!-- endregion -->

        <Preference
            android:icon="@drawable/ic_delete"
            app:key="reset_identifiers"
            app:summary="@string/reset_identifiers_summary"
            app:title="@string/reset_identifiers" />

    </PreferenceCategory>

    <!-- What the app records locally while browsing -->
    <PreferenceCategory app:title="@string/privacy_category_data">

        <!-- one tap, confirmed: every trace of what was watched or searched, at once -->
        <Preference
            android:icon="@drawable/ic_delete"
            app:key="clear_everything"
            app:summary="@string/clear_everything_summary"
            app:title="@string/clear_everything" />

        <!-- region Watch History -->
        <ListPreference
            app:defaultValue="0"
            app:entries="@array/history_retention_entries"
            app:entryValues="@array/history_retention_values"
            app:key="history_retention_days"
            app:summary="@string/history_retention_summary"
            app:title="@string/history_retention_title" />
        <!-- endregion -->

        <!-- region Search -->
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:icon="@drawable/ic_suggestions"
            app:key="search_suggestions"
            app:summary="@string/watube_search_suggestions_summary"
            app:title="@string/show_search_suggestions" />
        <!-- endregion -->

        <!-- region Related Videos -->
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:icon="@drawable/ic_list"
            app:key="related_streams_toggle"
            app:summary="@string/related_streams_summary"
            app:title="@string/related_streams" />
        <!-- endregion -->

    </PreferenceCategory>

</PreferenceScreen>
<!-- endregion -->
